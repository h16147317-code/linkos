generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Founder {
  id            String        @id @default(uuid())
  name          String
  email         String        @unique
  company_name  String
  stage         String
  industry      String
  pitch_summary String?
  created_at    DateTime      @default(now())
  applications  Application[]
  linkages      Linkage[]
}

model Application {
  id                String    @id @default(uuid())
  founder_id        String
  batch_id          String
  problem           String?
  solution          String?
  traction          String?
  ask               String?
  score             Int?
  tier              String?
  problem_clarity   Int?
  solution_strength Int?
  traction_score    Int?
  team_fit          Int?
  summary           String?
  scored_at         DateTime?
  status            String    @default("processing")
  created_at        DateTime  @default(now())
  founder           Founder   @relation(fields: [founder_id], references: [id])
}

model Batch {
  id         String   @id @default(uuid())
  status     String   @default("processing")
  total      Int
  completed  Int      @default(0)
  created_at DateTime @default(now())
}

model Mentor {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  expertise    String[]
  industry     String[]
  capacity     Int       @default(3)
  current_load Int       @default(0)
  past_cohorts Int       @default(0)
  success_rate Float     @default(0.0)
  availability Boolean   @default(true)
  bio          String?
  created_at   DateTime  @default(now())
  linkages     Linkage[]
}

model Linkage {
  id         String   @id @default(uuid())
  founder_id String
  mentor_id  String
  cohort     Int
  outcome    String?
  notes      String?
  created_at DateTime @default(now())
  founder    Founder  @relation(fields: [founder_id], references: [id])
  mentor     Mentor   @relation(fields: [mentor_id], references: [id])
}

model CohortPattern {
  id           String   @id @default(uuid())
  pattern_text String
  severity     String   @default("info")
  detected_at  DateTime @default(now())
}
